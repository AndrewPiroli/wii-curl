pkgname=wii-mbedtls
pkgver=4.0.0
pkgrel=1
pkgdesc='An open source, portable, easy to use, readable and flexible SSL library (for Nintendo Wii homebrew development)'
arch=('any')
url='https://tls.mbed.org/'
license=('apache')
options=(!strip libtool staticlibs)
depends=('ppc-zlib' 'libogc>=3.0.0')
makedepends=('wii-cmake' 'wii-pkg-config')
source=( "https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-${pkgver}/mbedtls-${pkgver}.tar.bz2"
         'timing_wii.c'
	 'timing_alt.h'
	 'platform_wii.c'
 )

sha256sums=('2f3a47f7b3a541ddef450e4867eeecb7ce2ef7776093f3a11d6d43ead6bf2827'
            'SKIP'
            'SKIP'
            'SKIP'
)

build() {
  cd mbedtls-$pkgver

  cp ../timing_wii.c library/timing_wii.c
  cp ../timing_alt.h include/mbedtls/timing_alt.h
  cp ../platform_wii.c tf-psa-crypto/drivers/builtin/src/platform_wii.c

  scripts/config.py unset MBEDTLS_PSA_BUILTIN_GET_ENTROPY
  scripts/config.py set MBEDTLS_PSA_DRIVER_GET_ENTROPY
  scripts/config.py set MBEDTLS_PLATFORM_MS_TIME_ALT
  scripts/config.py set MBEDTLS_TIMING_ALT
  # Remove when select() is available
  scripts/config.py unset MBEDTLS_NET_C

  mkdir build
  powerpc-eabi-cmake -DCMAKE_TOOLCHAIN_FILE="${DEVKITPRO}/cmake/Wii.cmake" \
    -DCMAKE_BUILD_TYPE="Release" \
    -DCMAKE_INSTALL_PREFIX="${DEVKITPRO}/portlibs/wii" \
    -DENABLE_TESTING=FALSE -DENABLE_PROGRAMS=FALSE \
    -S . -B build
  make -C build -j32

}

package() {

  cd mbedtls-$pkgver

  make -C build install DESTDIR="$pkgdir"

  install -d "$pkgdir"$PORTLIBS_PREFIX/licenses/$pkgname
  cp -v LICENSE "$pkgdir"$PORTLIBS_PREFIX/licenses/$pkgname 

} 
